# ═══════════════════════════════════════════════════════════
#  SYNAPSE COUNCIL — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ─── NVIDIA NIM API Keys (one per agent) ──────────────────
CEO_API_KEY=nvapi-your-ceo-key
PRODUCT_API_KEY=nvapi-your-product-key
BACKEND_API_KEY=nvapi-your-backend-key
FRONTEND_API_KEY=nvapi-your-frontend-key
CLOUD_API_KEY=nvapi-your-cloud-key
SECURITY_API_KEY=nvapi-your-security-key
QA_API_KEY=nvapi-your-qa-key
MARKETING_API_KEY=nvapi-your-marketing-key
CUSTOMER_API_KEY=nvapi-your-customer-key
DESIGN_API_KEY=nvapi-your-design-key

# ─── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=synapse_council
DB_USER=synapse
DB_PASSWORD=synapse_dev_2026

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Qdrant ───────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ─── MinIO ────────────────────────────────────────────────
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=synapse_admin
MINIO_SECRET_KEY=synapse_minio_2026

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=86400000
